<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>Macaron</title>
    <style>
      html, body {
        margin: 0;
        padding: 0;
      }

      #loading-page {
        position: absolute;
        background: transparent;
        -webkit-app-region: drag;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
      }

      .spinner {
        width: 36px;
        height: 36px;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translateX(-50%) translateY(-50%);
        border-radius: 50%;
        border: 3px solid transparent;
        border-top-color: var(--spinner-color, rgba(59, 130, 246, 1));
        border-right-color: var(--spinner-color, rgba(59, 130, 246, 0.3));
        -webkit-animation: spinner-rotate 0.8s linear infinite;
        animation: spinner-rotate 0.8s linear infinite;
      }

      @-webkit-keyframes spinner-rotate {
        0% { -webkit-transform: translateX(-50%) translateY(-50%) rotate(0deg); }
        100% { -webkit-transform: translateX(-50%) translateY(-50%) rotate(360deg); }
      }

      @keyframes spinner-rotate {
        0% { transform: translateX(-50%) translateY(-50%) rotate(0deg); }
        100% { transform: translateX(-50%) translateY(-50%) rotate(360deg); }
      }
    </style>
    <% if (htmlWebpackPlugin.options.nodeModules) { %>
      <!-- Add `node_modules/` to global paths so `require` works properly in development -->
      <script>
        require('module').globalPaths.push('<%= htmlWebpackPlugin.options.nodeModules.replace(/\\/g, '\\\\') %>')
      </script>
    <% } %>
  </head>
  <body autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false">
    <!-- Vue app -->
    <div id="app"></div>

    <!-- Loading page on application startup -->
    <div id="loading-page">
      <div class="spinner dot"></div>
    </div>

    <script>
      const params = new URLSearchParams(window.location.search)
      const THEMES_COLOR = {
        'one-dark': 'rgba(198, 120, 221, 1)',
        'dark': '#5B8DEF',
        'graphite': '#4A5568',
        'material-dark': '#4DB6AC',
        'light': 'rgba(59, 130, 246, 1)',
        'ulysses': '#C05621'
      }

      const color = THEMES_COLOR[params.get('theme')] || 'rgba(59, 130, 246, 1)'
      const spinner = document.querySelector('.dot')
      if (spinner) {
        spinner.style.setProperty('--spinner-color', color)
        spinner.style.borderTopColor = color
        spinner.style.borderRightColor = color.replace(/[\d.]+\)$/, '0.3)')
      }
    </script>

    <!-- Set `__static` path to static files in production -->
    <% if (!htmlWebpackPlugin.options.isBrowser && !htmlWebpackPlugin.options.isDevelopment) { %>
      <script>
        window.__static = require('path').join(__dirname, '/static').replace(/\\/g, '\\\\')
      </script>
    <% } %>

    <!-- webpack builds are automatically injected -->
  </body>
</html>
